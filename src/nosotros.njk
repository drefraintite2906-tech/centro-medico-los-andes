---
layout: layouts/base.njk
titulo: Nosotros
permalink: /nosotros/
descripcion_seo: "Conoce Centro Médico Los Andes, clínica privada en el Centro Comercial Los Andes, Panamá: misión, visión y valores."
---
{% import "partials/macros.njk" as m with context %}
{{ m.pageHero(nosotros.titulo, "Una clínica privada cercana, integral y comprometida con la prevención.", "Quiénes somos", "cruz") }}

<section class="section">
  <div class="container split split--center">
    <div>
      <p class="eyebrow">Centro Médico Los Andes</p>
      <h2>Atención integral en un solo lugar</h2>
      <div class="lead">{{ nosotros.intro | md | safe }}</div>
      <div class="btn-row">
        <a class="btn btn--primary" href="/agendar-cita/">{% icon "calendario" %}Agendar cita</a>
        <a class="btn btn--outline" href="/contacto/">Cómo llegar</a>
      </div>
    </div>
    <div>
      {%- if nosotros.imagen %}
        <img class="rounded-img" src="{{ nosotros.imagen }}" alt="Instalaciones de {{ clinica.nombre }}" loading="lazy" width="720" height="540">
      {%- else %}
        <div class="feature-grid feature-grid--light">
          {%- for p in nosotros.por_que %}<div class="feature">{% icon p.icono %}<strong>{{ p.titulo }}</strong><span>{{ p.texto }}</span></div>{% endfor %}
        </div>
      {%- endif %}
    </div>
  </div>
</section>

<section class="section section--tint">
  <div class="container grid grid--2">
    <div class="card card--pad reveal"><span class="card__icon card__icon--lg">{% icon "diana" %}</span><h3>Misión</h3><p>{{ nosotros.mision }}</p></div>
    <div class="card card--pad reveal"><span class="card__icon card__icon--lg">{% icon "ojo" %}</span><h3>Visión</h3><p>{{ nosotros.vision }}</p></div>
  </div>
</section>

<section class="section">
  <div class="container">
    {{ m.sectionHead("Nuestros valores", "", "Lo que nos guía") }}
    <div class="grid grid--4">
      {%- for v in nosotros.valores %}
      <div class="value reveal"><span class="value__num">{{ loop.index }}</span><h3>{{ v.titulo }}</h3><p>{{ v.texto }}</p></div>
      {%- endfor %}
    </div>
  </div>
</section>

{%- if nosotros.imagen %}
<section class="section section--tint">
  <div class="container">
    {{ m.sectionHead("¿Por qué elegirnos?", "", "") }}
    <div class="grid grid--4">
      {%- for p in nosotros.por_que %}<div class="card card--pad reveal"><span class="card__icon">{% icon p.icono %}</span><h3 class="card__title">{{ p.titulo }}</h3><p class="card__text">{{ p.texto }}</p></div>{% endfor %}
    </div>
  </div>
</section>
{%- endif %}

{%- if collections.medicos.length %}
<section class="section">
  <div class="container">
    {{ m.sectionHead("Nuestro equipo", "Profesionales comprometidos con tu salud.", "Equipo médico") }}
    <div class="grid grid--4">{% for doc in collections.medicos %}{% include "partials/doctor-card.njk" %}{% endfor %}</div>
  </div>
</section>
{%- endif %}

{{ m.ctaBand("Estamos para atenderte", "Visítanos en el Centro Comercial Los Andes, local B15, frente a Doit Center.") }}
